{
  "name": "iskralauncher",
  "version": "1.0.0",
  "description": "IskraLauncher — a resizable launcher for games via shortcut URLs (steam://, roblox:// ...)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/gen-icons.js",
    "version:bump": "node scripts/bump-version.js",
    "pack": "node scripts/pack.js",
    "installer": "node scripts/build-installer.js",
    "dist": "electron-builder --win"
  },
  "author": "BnTr58",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.iskra.launcher",
    "productName": "IskraLauncher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "IskraLauncher-portable.exe"
    }
  }
}
